# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Hosted: paste the URL from your Postgres provider (e.g. Neon).
# Local:  run `npx prisma dev` in a separate terminal and paste the URL it prints.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Secret key for signing session JWTs (HS256).
# Generate with `openssl rand -base64 32`.
AUTH_SECRET="your-secret-key-at-least-32-chars"
